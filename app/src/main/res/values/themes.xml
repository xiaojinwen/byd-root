<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- F7F7F7 = miuix lightColorScheme().surface，与 Scaffold / 顶栏 / 底栏同色，避免启动瞬间闪色。 -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#FF3482F6</item>
        <item name="android:windowBackground">#FFF7F7F7</item>
        <item name="android:statusBarColor">#FFF7F7F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFF7F7F7</item>
        <item name="android:textColorPrimary">#FF1A1C1E</item>
        <item name="android:textColorSecondary">#FF6B7280</item>
    </style>
</resources>
